# Biddle-Shaw — environment variables (placeholders only, never commit real values)
#
# Copy this file to .env.local for local dev, or set the variables in the Vercel
# project dashboard for deployed environments. .env.local is git-ignored.
#
# As of this commit no env vars are referenced in source — every entry below is
# a forward-looking placeholder for integrations the project may grow into.

# Site URL used for absolute links / OG tags / sitemap. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://www.biddleshaw.com

# AgentInsure embedded quoting portal (used by /quote). Already hard-coded in
# app/quote/page.tsx; expose via env only if the slug changes per environment.
# NEXT_PUBLIC_AGENTINSURE_QUOTE_URL=https://www.agentinsure.com/compare/auto-insurance-home-insurance/bshawins/quote.aspx

# Analytics / tag IDs (only set in production envs).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Form submission backend (Email an Agent, Contact, Quote forms are UI-only today).
# CONTACT_FORM_ENDPOINT=https://example.com/api/contact
# CONTACT_FORM_API_KEY=your-form-provider-key
